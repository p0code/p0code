# Copy to .env and fill in the first two lines.
# The relay's own hostname. RELAY_HOST and *.RELAY_HOST must both point here.
RELAY_HOST=relay.example.com
# ACME contact for the relay's own certificate. Optional.
RELAY_ACME_EMAIL=you@example.com

# Pin an image tag so installs are reproducible: a vX.Y.Z release or sha-<short>.
# Left unset, compose follows latest, which moves with every push to main.
# RELAY_VERSION=latest

# Public tunnels: <name>-<slug> hostnames for dev servers, files, static folders.
# Off unless RELAY_PUBLIC_HOSTS is 1. See the "Public hosts" section of the setup doc.
# RELAY_PUBLIC_HOSTS=
# RELAY_PUBLIC_DOMAIN=

# Let visitors create their own account (POST /_hhh/auth/register). Off by default.
# RELAY_ALLOW_SIGNUP=

# Bring your own PEM certificate and key instead of ACME. Put both files in the
# data volume and give their paths as seen inside the container, for example:
# RELAY_CERT=/data/certs/relay.pem
# RELAY_KEY=/data/certs/relay.key
