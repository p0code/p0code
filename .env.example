# Relay access is configured on the environment at runtime:
# t3 relay link https://relay.example.com --token <enrollment-token>
# T3CODE_PUBLIC_ORIGIN=https://my-own-reverse-proxy.example.com
# T3CODE_ACME_EMAIL=admin@example.com
# T3CODE_ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
# Optional environment-owned certificate (private CA or BYO wildcard):
# T3CODE_RELAY_CERT=/absolute/path/fullchain.pem
# T3CODE_RELAY_KEY=/absolute/path/privkey.pem
# Optional private CA for the relay's control-channel certificate:
# T3CODE_RELAY_CA_CERT=/absolute/path/relay-ca.pem
